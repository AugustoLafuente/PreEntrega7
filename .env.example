# ==============================================================================
# ARCHIVO DE PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Este archivo es solo una plantilla de ejemplo para el desarrollo del proyecto.
# NO contiene credenciales reales ni información sensible.
#
# Para usarlo en tu entorno local:
# 1. Copia este archivo y nómbralo como .env
# 2. Reemplaza los valores de ejemplo por tus configuraciones y credenciales reales.
# ==============================================================================

PORT=8080
NODE_ENV=development
MONGO_URL=mongodb://localhost:27017/tu_base_de_datos
JWT_SECRET=tu_secreto_jwt_aqui
JWT_EXPIRES_IN=1h

# Credenciales SMTP para el envío de emails de confirmación (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_contraseña_de_aplicacion
MAIL_FROM=tu_correo@gmail.com
